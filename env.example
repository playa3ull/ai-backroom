# API Keys for LLM providers
OPENAI_API_KEY=your-openai-api-key-here

# Gemini API key for Gemini models
# Get your key at: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# Search API Keys
# The application will prioritize search tools in this order: Tavily > Exa > DuckDuckGo
# If you don't have keys for Tavily or Exa, DuckDuckGo will be used as a fallback (no API key required)

# Tavily API Key (highest priority search)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here

# Exa API Key (second priority search)
# Get your key at: https://exa.ai/
EXA_API_KEY=your-exa-api-key-here

# Other API keys can be added here

# To use this file:
# 1. Rename it from env.example to .env
# 2. Replace the placeholders with your actual API keys
# 3. The application will automatically load these keys on startup 